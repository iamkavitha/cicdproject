pipeline {
  agent {
    docker {
            image 'maven:3.9-eclipse-temurin-21'
            args '--user root -e HOME=/root -v /var/run/docker.sock:/var/run/docker.sock'
        }
//     docker {
//       image 'abhishekf5/maven-abhishek-docker-agent:v1'
//       args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
//     }
  }
  stages {
    stage('Check Environment') {
      steps {
        sh '''
              echo "===== ENVIRONMENT ====="
               echo "USER=$(whoami)"
               echo "HOME=$HOME"
               java -version
               mvn -version
               echo "Maven repository:"
               mvn help:evaluate -Dexpression=settings.localRepository -q -DforceStdout
          '''
      }
  }

    stage('Checkout') {
      steps {
        sh 'echo passed'
        git branch: 'main', url: 'https://github.com/iamkavitha/cicdproject'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'mvn clean package'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://54.86.165.100:9000/"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
              mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar \
                -Dsonar.login=$SONAR_AUTH_TOKEN \
                -Dsonar.host.url=$SONAR_URL
          '''

        }
      }
    }
    stage('Install Docker CLI') {
        steps {
            sh '''
                apt-get update
                apt-get install -y docker.io
                docker --version
            '''
        }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "20223049/ultimate-cicd:${BUILD_NUMBER}"
        DOCKERFILE_LOCATION = "Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
            sh 'docker build -t ${DOCKER_IMAGE} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                dockerImage.push()
            }
        }
      }
    }

    stage('Install Helm') {
                steps {
                    sh '''
                        apt-get update
                        apt-get install -y curl

                        curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

                        helm version
                    '''
                }
            }

    stage('Update Helm Image Tag') {
        environment {
            GIT_REPO_NAME = 'cicdproject_deployment'
            GIT_USER_NAME = 'iamkavitha'
        }

        steps {
            withCredentials([
                string(credentialsId: 'github', variable: 'GITHUB_TOKEN')
            ]) {
                sh '''
                    rm -rf deployment-repo

                    git clone https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git deployment-repo

                    cd deployment-repo

                    git config user.email "kaviranga9344@gmail.com"
                    git config user.name "Kavitha Mallesh"

                    echo "===== BEFORE UPDATE ====="
                    cat helm/cicdproject/values.yaml

                    echo "Updating image tag to ${BUILD_NUMBER}"

                    sed -i "s/^  tag:.*/  tag: \\"${BUILD_NUMBER}\\"/" \
                        helm/cicdproject/values.yaml

                    echo "===== AFTER UPDATE ====="
                    cat helm/cicdproject/values.yaml

                    echo "===== HELM LINT ====="
                    helm lint helm/cicdproject

                    echo "===== HELM TEMPLATE ====="
                    helm template cicdproject helm/cicdproject

                    git add helm/cicdproject/values.yaml

                    git commit \
                        -m "Update image to version ${BUILD_NUMBER}" \
                        || echo "Nothing to commit"

                    git push origin main
                '''
            }
        }
    }

  }
}